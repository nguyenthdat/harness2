{
  "$schema": "https://raw.githubusercontent.com/can1357/oh-my-pi/main/packages/coding-agent/src/config/mcp-schema.json",
  "mcpServers": {
    "ida": {
      "type": "stdio",
      "command": "ida-mcp",
      "args": ["stdio", "--agent=omp-re", "--idle-timeout=900"],
      "env": {
        "IDADIR": "IDADIR",
        "IDAPYTHON_VENV_EXECUTABLE": "OMP_IDA_PYTHON",
        "IDA_NEXUS_IDALIB_ONLY": "1"
      },
      "timeout": 120000
    },
    "rea": {
      "type": "stdio",
      "command": "bunx",
      "args": ["rea-agents@6.4.0", "mcp"],
      "env": {
        "GHIDRA_INSTALL_DIR": "${GHIDRA_INSTALL_DIR}",
        "JAVA_HOME": "${JAVA_HOME}",
        "REA_ANALYSIS_PROVIDER": "ghidra",
        "REA_JADX_MCP_JAR": "${REA_JADX_MCP_JAR}"
      }
    }
  }
}
